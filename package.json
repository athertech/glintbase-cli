    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "typescript": "^5.8.0",
    "untun": "^0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/prompts": "^2.4.9",
